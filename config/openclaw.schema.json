{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openclaw.schema.json",
  "title": "OpenClaw configuration",
  "description": "JSON Schema (draft 2020-12) for config/openclaw.json",
  "type": "object",
  "required": ["models", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "models": {
      "type": "object",
      "required": ["providers"],
      "properties": {
        "providers": {
          "type": "object",
          "description": "Keyed provider map; each value is a provider config object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl":  { "type": "string" },
              "apiKey":   { "type": "string" },
              "api":      { "type": "string" },
              "_note":    { "type": "string" },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id":            { "type": "string" },
                    "contextWindow": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "required": ["list"],
      "properties": {
        "defaults": { "type": "object" },
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "model", "workspace"],
            "properties": {
              "id":        { "type": "string" },
              "name":      { "type": "string" },
              "model":     { "type": "string" },
              "workspace": { "type": "string" },
              "effort":    { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "slack":   { "type": "object" },
    "logging": { "type": "object" }
  },
  "additionalProperties": true
}
